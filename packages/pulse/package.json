{
  "name": "@sankofa/pulse",
  "version": "0.2.0",
  "description": "Sankofa Pulse — in-app surveys, NPS, and CSAT feedback for web apps.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sankofa-HQ/sankofa_sdk_web"
  },
  "keywords": [
    "sankofa",
    "pulse",
    "surveys",
    "nps",
    "csat",
    "feedback"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "bundle": "node esbuild.config.js",
    "test": "node --import tsx --test src/__tests__/*.test.ts",
    "prepublishOnly": "npm run build && npm run bundle"
  },
  "dependencies": {
    "@sankofa/browser": "0.2.0"
  },
  "devDependencies": {
    "esbuild": "^0.27.4",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
