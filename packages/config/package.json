{
  "name": "@sankofa/config",
  "version": "0.2.0",
  "description": "Sankofa Config — type-safe remote configuration for web apps.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sankofa-HQ/sankofa_sdk_web"
  },
  "keywords": [
    "sankofa",
    "config",
    "remote-config",
    "feature-flags",
    "self-hosted"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "bundle": "node esbuild.config.js",
    "test": "node --import tsx --test src/__tests__/*.test.ts",
    "prepublishOnly": "npm run build && npm run bundle"
  },
  "dependencies": {
    "@sankofa/browser": "0.2.0"
  },
  "devDependencies": {
    "esbuild": "^0.27.4",
    "tsx": "^4.19.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
