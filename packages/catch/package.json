{
  "name": "@sankofa/catch",
  "version": "0.2.0",
  "description": "Sankofa Catch — JavaScript error tracking, crash reporting, breadcrumbs, and Web Vitals for the browser.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sankofa-HQ/sankofa_sdk_web"
  },
  "keywords": [
    "sankofa",
    "catch",
    "error-tracking",
    "crash-reporting",
    "exceptions",
    "self-hosted"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "bundle": "node esbuild.config.js",
    "prepublishOnly": "npm run build && npm run bundle"
  },
  "dependencies": {
    "@sankofa/browser": "0.2.0"
  },
  "devDependencies": {
    "esbuild": "^0.27.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
