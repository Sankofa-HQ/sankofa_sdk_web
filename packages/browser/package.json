{
  "name": "@sankofa/browser",
  "version": "0.2.0",
  "description": "Sankofa Web SDK — privacy-first product analytics, event tracking, and identity for the browser. Self-hosted and open source.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sankofa-HQ/sankofa_sdk_web"
  },
  "keywords": [
    "sankofa",
    "analytics",
    "tracking",
    "sdk",
    "events",
    "self-hosted",
    "open-source"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "bundle": "node esbuild.config.js",
    "prepublishOnly": "npm run build && npm run bundle"
  },
  "devDependencies": {
    "esbuild": "^0.27.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
